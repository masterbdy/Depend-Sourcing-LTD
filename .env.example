# SMTP Configuration for Backend Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set SMTP_SECURE=true if using port 465, false for 587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# Firebase Cloud Messaging (Web Push / Android APK Push)
# Generate a Web Push certificate key pair in Firebase Console -> Project Settings -> Cloud Messaging
VITE_FIREBASE_VAPID_KEY=
# JSON string (or base64) of Firebase Admin Service Account for server-side FCM HTTP v1 & Cron RTDB access
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional shared secret for securing /api/cron-reminders
CRON_SECRET=
